		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-ai": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-natives": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
