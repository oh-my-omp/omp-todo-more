{
	"name": "omp-todo-more",
	"version": "0.1.16",
	"description": "Branch-owned rich todos, reminders and native OMP/Tern editing",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-todo-more.git"
	},
	"files": [
		"index.ts",
		"src",
		"tern"
	],
	"omp": {
		"extensions": [
