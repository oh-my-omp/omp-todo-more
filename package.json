{
	"name": "omp-todo-ng",
	"version": "0.3.1",
	"description": "Branch-owned rich todos, reminders and native OMP/Tern editing",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-todo-ng.git"
	},
	"files": [
		"index.ts",
		"src",
		"tern",
		"omomp-shared",
		"CHANGELOG.md"
	],
	"omomp": {
		"changelog": "CHANGELOG.md"
	},
	"omp": {
		"extensions": [
			"./index.ts"
		],
		"settings": {
			"leafMaxMinutes": {
				"type": "number",
				"default": 60,
				"min": 1,
				"max": 1440,
				"step": 1,
				"description": "Largest estimate in minutes a todo item may carry; longer work must be split into several items"
			}
		}
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"test": "bun test",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"@oh-my-pi/omptype": "*",
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-catalog": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-natives": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/omptype": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-ai": "latest",
		"@oh-my-pi/pi-catalog": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-natives": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
