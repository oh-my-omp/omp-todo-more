{
	"name": "omp-todo-more",
	"version": "0.1.33",
	"description": "Branch-owned rich todos, reminders and native OMP/Tern editing",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-todo-more.git"
	},
	"files": [
		"index.ts",
		"src",
		"tern"
	],
	"omp": {
		"extensions": [
			"./index.ts"
		],
		"settings": {
			"reminders": {
				"type": "boolean",
				"default": true,
				"description": "Remind the agent when it stops with incomplete todo items, and nudge it mid-run when the list goes untouched"
			},
			"remindersMax": {
				"type": "number",
				"default": 3,
				"min": 0,
				"max": 100,
				"step": 1,
				"description": "Stop reminders per stop chain before giving up"
			},
			"eager": {
				"type": "enum",
				"values": [
					"default",
					"preferred",
					"always"
				],
				"default": "default",
				"description": "Ask for a todo list on the first prompt: preferred reminds, always forces the todo tool call"
			}
		}
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-natives": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-ai": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-natives": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"typescript": "latest"
	}
}
